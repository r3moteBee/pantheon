# ============================================================
# Pantheon — Environment Configuration Template
# Copy this file to .env and fill in your values.
#
# Sections:
#   1. Required secrets
#   2. App settings (backend/config.py Settings class)
#   3. Read directly by modules (os.getenv outside config.py)
#   4. Installer / deploy / docker-compose variables
#
# start.sh sources this file (set -a) and docker-compose passes it as
# env_file, so every variable here reaches the backend process.
# Commented-out lines show the built-in default.
# ============================================================


# ============================================================
# 1. Required secrets
# ============================================================
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# (Automatically populated by deploy.sh / setup_options.sh while the
# placeholders below are still present.)
VAULT_MASTER_KEY=change-this-to-a-random-64-char-hex-string-before-deploy
SECRET_KEY=change-this-to-another-random-secret-key-for-jwt
# Password for the web interface. Leave empty to disable auth (not safe on public servers).
AUTH_PASSWORD=insert-auth-password-here
# While VAULT_MASTER_KEY, SECRET_KEY or AUTH_PASSWORD still hold the values
# above (or the built-in defaults), Pantheon serves local clients only. To
# rotate VAULT_MASTER_KEY later without losing stored secrets, stop Pantheon
# and run:  ./.venv/bin/python scripts/rotate_vault_key.py


# ============================================================
# 2. App settings (backend/config.py — Settings)
# ============================================================
# Env var name = field name upper-cased. Values saved in the web UI
# (Settings, stored in the vault) take precedence over these where the
# UI exposes the same setting.

# ------------------------------------------------------------
# Security / auth
# ------------------------------------------------------------
# Login sessions last this many days (changing AUTH_PASSWORD logs everyone out).
# AUTH_SESSION_DAYS=30
# Public hostnames allowed when AUTH_PASSWORD is empty (DNS-rebinding guard).
# IPs, localhost and *.local/*.lan are always allowed.
# ALLOWED_HOSTS=pantheon.example.com
# Serve remote clients even while the secrets above are defaults/placeholders (not recommended).
# ALLOW_INSECURE_DEFAULTS=false

# ------------------------------------------------------------
# LLM bootstrap fallback
# ------------------------------------------------------------
# LLM configuration lives in the web UI (Settings → Endpoints / Model
# routing, API: /api/llm/*). These four are only used as a fallback
# provider when no route is configured for the agent / embed classes,
# and are what the installers write. Any OpenAI-compatible API works.
LLM_BASE_URL=insert-llm-base-url-here
LLM_API_KEY=insert-llm-api-key-here
LLM_MODEL=insert-llm-model-name-here
# Embedding model for the fallback provider, e.g. text-embedding-3-small
# (OpenAI) or nomic-embed-text (Ollama). Uses the LLM base URL / key above
# unless EMBEDDING_BASE_URL is set (then EMBEDDING_API_KEY, never LLM_API_KEY).
EMBEDDING_MODEL=insert-embedding-model-here
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
#
# Examples:
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1       LLM_MODEL=gpt-4o
#   Ollama:      LLM_BASE_URL=http://localhost:11434/v1       LLM_API_KEY=ollama
#   Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
#
# Legacy per-role variables (LLM_PREFILL_MODEL, LLM_VISION_MODEL,
# VISION_BASE_URL/API_KEY, PREFILL_BASE_URL/API_KEY,
# RERANKER_MODEL/BASE_URL/API_KEY) are ignored: nothing reads them
# from the environment any more. Configure those roles in the web UI.

# ------------------------------------------------------------
# Search
# ------------------------------------------------------------
# URL of a search backend. Leave empty to use DuckDuckGo (no key needed).
# SearXNG (self-hosted):  http://localhost:8080
# Brave Search API:       https://api.search.brave.com/res/v1/web/search
# (Automatically populated by deploy.sh if SearXNG option selected)
SEARCH_URL=
# API key if required by the search backend (e.g. Brave Search API key).
SEARCH_API_KEY=

# ------------------------------------------------------------
# Messaging integrations (optional)
# ------------------------------------------------------------
# Every allowlist below is deny-by-default: EMPTY = NOBODY can use the bot.
# List the IDs (comma-separated) you want the bot to answer.

# Telegram — get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated allowed Telegram chat IDs (empty = bot answers no one)
TELEGRAM_ALLOWED_CHAT_IDS=

# Discord — create a bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
# Comma-separated allowed Discord guild (server) IDs (empty = bot answers no guild)
DISCORD_ALLOWED_GUILD_IDS=

# Slack — create a Slack App with Socket Mode
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Comma-separated allowed Slack channel IDs (empty = bot answers no channel)
SLACK_ALLOWED_CHANNEL_IDS=

# Matrix — configure bot credentials
MATRIX_HOMESERVER_URL=https://matrix.org
MATRIX_USER_ID=
MATRIX_ACCESS_TOKEN=
# Comma-separated allowed Matrix room IDs (empty = bot answers no room)
MATRIX_ALLOWED_ROOM_IDS=

# Mattermost — configure bot access token
MATTERMOST_URL=
MATTERMOST_BOT_TOKEN=
MATTERMOST_SCHEME=https
MATTERMOST_PORT=443
# Comma-separated allowed Mattermost channel IDs (empty = bot answers no channel)
MATTERMOST_ALLOWED_CHANNEL_IDS=

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
# Built-in default is "development"; only reported by /api/settings.
APP_ENV=production
LOG_LEVEL=INFO
# Host-execution tools (run_command, code_execute, git_*) run shell commands
# on this machine. Ingested content can carry prompt-injected instructions,
# so by default they're only offered in web-UI chat and coding_task jobs.
#   interactive (default) | always (also scheduled jobs + chat bots) | never
AGENT_HOST_EXEC=interactive

# Ask the agent-class model to think before acting (sends chat_template_kwargs
# {"enable_thinking": true} — llama.cpp / vLLM serving Qwen-family and similar
# models). Makes small local models far more reliable at calling tools for
# current facts, at some latency. Leave off for providers that reject the field.
# AGENT_THINKING=false

# Let agent downloads / source adapters fetch private, loopback and
# link-local addresses (e.g. intranet pages). Off = SSRF protection.
ALLOW_PRIVATE_FETCH=false

# Comma-separated CORS origins for development. Also the allowlist for
# cross-origin WebSocket connections (same-host origins are always allowed).
CORS_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:80

# ------------------------------------------------------------
# ChromaDB
# ------------------------------------------------------------
# Set CHROMA_HOST to use a ChromaDB server; empty = embedded store under
# DATA_DIR/chroma. deploy.sh clears it for local installs; docker-compose
# sets chromadb:8001 for the container.
CHROMA_HOST=
CHROMA_PORT=8001

# ------------------------------------------------------------
# Active memory & curation
# ------------------------------------------------------------
# Auto-extraction: run LLM-based entity/fact extraction after this many
# messages per session. Set to 0 to only extract on session consolidation.
# Recommended: 10-20 for active learning, 0 for manual control.
EXTRACTION_INTERVAL=0
# Automatically index uploaded files into semantic memory (true/false).
AUTO_INDEX_UPLOADS=true
# Chunk size for file indexing (in tokens). Settings UI value wins.
FILE_CHUNK_SIZE=500
# Chunk overlap (in tokens). Settings UI value wins.
FILE_CHUNK_OVERLAP=50
# Chunking strategy: headings | paragraphs | fixed. Settings UI value wins.
# FILE_CHUNK_STRATEGY=headings
# Personality presence: minimal | balanced | strong. Prefer Settings / project settings.
# PERSONALITY_WEIGHT=balanced
# Recency weighting of context: broad | balanced | focused. Prefer Settings / project settings.
# CONTEXT_FOCUS=balanced
# Seconds a chat turn waits for memory recall before answering without memory context.
# PRE_RECALL_TIMEOUT_SECONDS=4.0
# Seconds to wait for the reranker before keeping the original order. Capped at
# PRE_RECALL_TIMEOUT_SECONDS - 1.5 so a reranker that is still loading can never
# cost the turn its recalled memories.
# RERANK_TIMEOUT_SECONDS=2.5
# Automatic pre-recall drops memories the reranker scores below this relevance
# (0-1; raw reranker logits are mapped through a sigmoid). 0 = keep everything.
# RECALL_MIN_RELEVANCE=0.05
# Conversation history sent per turn, in tokens. 0 = auto (a quarter of the
# agent model's context window, 2K-24K); -1 = no limit. Older turns are dropped
# in blocks and stay reachable through recall.
# HISTORY_TOKEN_BUDGET=0
# Dropped turns of the current conversation come back through recall when their
# embedding similarity to the new message is at least this (0 = off).
# RECALL_SESSION_MIN_SIMILARITY=0.45

# ------------------------------------------------------------
# Data directory
# ------------------------------------------------------------
# /app/data inside the container; deploy.sh sets <install dir>/data for local installs.
DATA_DIR=/app/data


# ============================================================
# 3. Read directly by modules (os.getenv outside config.py)
# ============================================================
# Agent loop
# Max tool-call rounds per agent turn (agent/core.py).
# MAX_TOOL_ITERATIONS=100
# Truncate a single tool result to this many characters before the model sees it.
# TOOL_RESULT_MAX_CHARS=24000

# Job system
# Set to false to not start the in-process JobWorker (main.py).
# JOB_WORKER_ENABLED=true
# Seconds between JobWorker polls for queued jobs.
# JOB_WORKER_POLL_SECONDS=1.0
# Jobs run at once. Repo jobs (coding_task, iteration_loop) stay one per project. 1 = sequential.
# JOB_WORKER_CONCURRENCY=2
# Seconds between JobWorker checks on running jobs (cancel / timeout).
# JOB_WORKER_SUPERVISE_SECONDS=2.0
# Seconds between stall-watchdog sweeps.
# JOB_STALL_CHECK_SECONDS=60
# A running job with no heartbeat for this many seconds is marked stalled.
# JOB_STALL_TIMEOUT_SECONDS=300
# Times an orphaned job (found running at startup) is re-queued before it fails.
# JOB_AUTO_REQUEUE_MAX=2

# Browser tools (Playwright)
# Enable the agent's browser tools (setup_options.sh --with-browser sets this).
# BROWSER_ENABLED=false
# Set to false to launch a visible browser window.
# BROWSER_HEADLESS=true
# Connect to a remote CDP browser (Browserless/Browserbase) instead of launching one.
# BROWSER_WS_URL=
# Use a system Chromium instead of Playwright's downloaded one.
# BROWSER_EXECUTABLE_PATH=
# User-Agent string for browser-tool page loads.
# BROWSER_USER_AGENT=Mozilla/5.0 (Pantheon Agent) Chrome/120 Safari/537.36

# Code-execution sandbox
# Sandbox backend for code_execute: subprocess | firecracker.
# PANTHEON_SANDBOX=subprocess
# Firecracker install dir (bin/, kernel, rootfs); FC_DIR is accepted as an alias.
# FIRECRACKER_DIR=/opt/firecracker
# Firecracker VM size, and free space on the workspace disk run_command gets.
# FC_MEM_MIB=1024
# FC_VCPUS=1
# FC_WORKSPACE_HEADROOM_MB=1024


# ============================================================
# 4. Installer / deploy / docker-compose variables
# ============================================================
# Read by start.sh (after sourcing this file)
# Interface uvicorn binds to. Default: 0.0.0.0 when AUTH_PASSWORD is set, else 127.0.0.1.
# BIND_HOST=0.0.0.0
# Port for the backend (serves the built UI too).
# BACKEND_PORT=8000
# Set to 1 to also serve frontend/dist on FRONTEND_PORT via python http.server.
# PANTHEON_DUAL_PORT=0
# Frontend port in dual-port mode.
# FRONTEND_PORT=3000

# Read by docker-compose.yml as backend build args (written by deploy.sh / setup_options.sh)
# Build LibreOffice into the backend image for document preview rendering.
INSTALL_OFFICE=false
# Install Playwright + Chromium into the backend image.
INSTALL_BROWSER=false

# Read by deploy.sh from the shell environment before .env exists
# (export them or pass flags; they are not read from this file):
#   PANTHEON_DIR   install directory (default ~/pantheon)
#   PANTHEON_PORT  host HTTP port for docker mode nginx (default 80)
#   LLM_BASE_URL / LLM_API_KEY / LLM_MODEL  initial LLM fallback values
